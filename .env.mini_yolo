# ============================================================
# MINI_YOLO 项目覆盖（未设置的项继承 .env 全局值，OS 环境变量优先级最高）
# ============================================================
MINI_YOLO_SUBDIR=mini_yolo

# 画布与网格（改动需保持 canvas/grid = 16 的下采样契约）
MINI_YOLO_CANVAS=64
MINI_YOLO_DIGIT_SIZE=32
MINI_YOLO_GRID=4
MINI_YOLO_NUM_CLS=10
MINI_YOLO_MAX_OBJS=2
MINI_YOLO_N_BOXES=2

MINI_YOLO_N_TRAIN=4000
MINI_YOLO_N_VAL=500

MINI_YOLO_LAMBDA_BOX=5.0
MINI_YOLO_LAMBDA_NOOBJ=0.5
