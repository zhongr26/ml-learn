# ============================================================
# 全局配置（各项目可覆盖项见 .env.mnist / .env.yolo）
# ============================================================

# ---------- 根目录（相对路径基于项目根，也可填绝对路径） ----------
BASE_DATA_DIR=./datasets
BASE_CHECKPOINT_DIR=./checkpoints
BASE_LOG_DIR=./logs
BASE_OUTPUT_DIR=./outputs

# ---------- 开关 ----------
# 强制重新训练（否则复用已有 checkpoint）
RETRAIN=0

# ---------- 公共训练超参默认值 ----------
BATCH_SIZE=64
NUM_WORKERS=2
LEARNING_RATE=0.001
MAX_EPOCHS=50
PATIENCE=5
SAVE_TOP_K=3
SEED=42
