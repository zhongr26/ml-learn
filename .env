# ============================================================
# 全局根目录（相对路径基于项目根，也可填绝对路径）
# ============================================================
BASE_DATA_DIR=./datasets
BASE_CHECKPOINT_DIR=./checkpoints
BASE_LOG_DIR=./logs
BASE_OUTPUT_DIR=./outputs

# 数据集子目录（每个数据集只需一行）
# 实际路径 = 对应 BASE_xxx_DIR / 子目录
MNIST_SUBDIR=mnist
# CIFAR10_SUBDIR=cifar10
# IMAGENET_SUBDIR=imagenet

# ============================================================
# 全局训练超参数
# ============================================================
BATCH_SIZE=64
NUM_WORKERS=2
LATENT_DIM=3
LEARNING_RATE=0.001
MAX_EPOCHS=50
PATIENCE=5
SAVE_TOP_K=3
SEED=42

# 数据集专属覆盖（可选，未设置则继承全局值）
MNIST_BATCH_SIZE=64
MNIST_MAX_EPOCHS=20
# 提升重建的精度
MNIST_LATENT_DIM=64