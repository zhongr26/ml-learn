# ============================================================
# YOLO 项目覆盖（未设置的项继承 .env 全局值，OS 环境变量优先级最高）
# ============================================================
YOLO_SUBDIR=yolo

# 预训练权重（n/s/m/l/x 规模递增）
YOLO_MODEL=yolo11n.pt
# ultralytics 数据集定义：coco8.yaml 为迷你验证集（自动下载），完整版用 coco.yaml
YOLO_DATA_YAML=coco8.yaml

YOLO_CONF=0.25
YOLO_IOU=0.7
YOLO_IMGSZ=640
